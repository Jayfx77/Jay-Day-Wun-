# Copy to .env (or set in your hosting dashboard)
NODE_ENV=production
PORT=3000
SITE_NAME=Ofie Accra
# Your public address. When set, visitors on any other host (e.g. *.onrender.com) are redirected here.
BASE_URL=https://your-domain.com
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_PHONE=+233 20 000 0000

# First admin account — created on startup if it doesn't exist
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Your Name
ADMIN_PHONE=0240000000

# Persistent storage — point these at a mounted volume in production
DB_FILE=/data/ofie.db
UPLOAD_DIR=/data/uploads
PRIVATE_DIR=/data/private

# SMS alerts and password-reset codes. Provider: arkesel | hubtel | log (log = print only, for testing)
SMS_PROVIDER=arkesel
SMS_SENDER_ID=OfieAccra
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_MESSAGE_COOLDOWN_MINUTES=30
# Most saved-search alert texts one person can get per 24 hours
SMS_SEARCH_ALERTS_PER_DAY=3

# Email (optional): also send password-reset links by email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@your-domain.com
# At most one "new message" email per conversation in this many minutes
EMAIL_MESSAGE_COOLDOWN_MINUTES=15
