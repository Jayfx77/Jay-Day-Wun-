# Settings for running Ofie Accra on your own laptop.
# Copy this file to ".env" (same folder). Never put real passwords for the live site here.

# Leave NODE_ENV out (or set "development"). "production" turns on secure cookies,
# which stops logins working on http://localhost.
PORT=3000

# Your admin login on this laptop (created the first time the server starts).
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=local-admin-password
ADMIN_NAME=Local Admin
ADMIN_PHONE=0200000000

# Texts are printed in the VS Code terminal instead of being sent. This is where you'll
# find phone verification and password-reset codes while testing.
SMS_PROVIDER=log

# Email is off unless you fill these in (optional for local testing).
SMTP_HOST=
